ный сын",""],[29890683,29890770,"т/с Супермен: Человек завтрашнего дня",""],[29890770,29890860,"т/с Тёмная Лига справедливости: Война Апоколипса",""],[29890860,29890944,"т/с Общество справедливости: Вторая мировая война",""],[29890944,29891032,"т/с Зелёный Фонарь: Берегись моей силы",""],[29891032,29891111,"т/с Бэтмен и Супермен: битва Суперсыновей",""],[29891111,29891157,"т/с Аквамен: Король Атлантиды 1 с.",""],[29891157,29891202,"т/с Аквамен: Король Атлантиды 2 с.",""],[29891202,29891244,"т/с Бэтвумен 1 с.",""],[29891244,29891291,"т/с Аквамен: Король Атлантиды 3 с.",""],[29891291,29891334,"т/с Бэтвумен 2 с.",""],[29891334,29891376,"т/с Бэтвумен 3 с.",""],[29891376,29891417,"т/с Бэтвумен 4 с.",""],[29891417,29891460,"т/с Бэтвумен 5 с.",""],[29891460,29891502,"т/с Бэтвумен 6 с.",""],[29891502,29891544,"т/с Бэтвумен 7 с.",""],[29891544,29891586,"т/с Бэтвумен 8 с.",""],[29891586,29891628,"т/с Бэтвумен 9 с.",""],[29891628,29891670,"т/с Бэтвумен 10 с.",""],[29891670,29891713,"т/с Бэтвумен 11 с.",""],[29891713,29891755,"т/с Бэтвумен 12 с.",""],[29891755,29891798,"т/с Бэтвумен 13 с.",""],[29891798,29891840,"т/с Бэтвумен 14 с.",""],[29891840,29891881,"т/с Бэтвумен 15 с.",""],[29891881,29891924,"т/с Бэтвумен 16 с.",""],[29891924,29891966,"т/с Бэтвумен 17 с.",""],[29891966,29892008,"т/с Бэтвумен 18 с.",""],[29892008,29892050,"т/с Бэтвумен 19 с.",""],[29892050,29892093,"т/с Бэтвумен 20 с.",""],[29892093,29892152,"т/с ДМЗ 1 с.",""],[29892152,29892210,"т/с ДМЗ 2 с.",""],[29892210,29892268,"т/с ДМЗ 3 с.",""],[29892268,29892329,"т/с ДМЗ 4 с.",""],[29892329,29892401,"т/с Пенниуорт 1 с.",""],[29892401,29892456,"т/с Пенниуорт 2 с.",""],[29892456,29892510,"т/с Пенниуорт 3 с.",""],[29892510,29892566,"т/с Пенниуорт 4 с.",""],[29892566,29892622,"т/с Пенниуорт 5 с.",""],[29892622,29892672,"т/с Пенниуорт 6 с.",""],[29892672,29892729,"т/с Пенниуорт 7 с.",""],[29892729,29892784,"т/с Пенниуорт 8 с.",""],[29892784,29892837,"т/с Пенниуорт 9 с.",""],[29892837,29892892,"т/с Пенниуорт 10 с.",""],