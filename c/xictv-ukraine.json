""],[29910850,29910945,"х/ф Широко крокуючи",""],[29910945,29911065,"х/ф Ремпейдж",""],[29911065,29911200,"х/ф Чорний Адам",""],[29911200,29911315,"х/ф Зубна фея",""],[29911315,29911435,"х/ф Півтора шпигуна",""],[29911435,29911540,"х/ф Національна безпека",""],[29911540,29911560,"х/ф Апґрейд ┊ 1",""],[29911560,29911570,"Звернення Президента України",""],[29911570,29911660,"х/ф Апґрейд ┊ 2",""],[29911660,29911805,"х/ф Брати Спаркс",""],[29911805,29913300,"Скетч-шоу На трьох","Усього три актори у кадрі – і величезна порція добірного гумору. Персонажі гумористичного шоу «На трьох» добре знайомі глядачам – це звичайні лікарі та хворі, ДАІшники та порушники, батьки та діти, поліцейські та…"],[29911880,29910480,"Громадянська оборона",""],[29911955,29912075,"т/с Відділ 44. 2 с-н","«Відділ 44» – спеціальний підрозділ київської поліції, який займається розслідуванням заплутаних злочинів за допомогою новітніх технологічних розробок. Загоном професіоналів різних галузей командує досвідчений слідчий…"],[29912075,29912305,"т/с АТП Перевізники ┊ 5-8",""],[29912305,29912640,"т/с АТП Перевізники 2 ┊ 11-16",""],[29912640,29912765,"х/ф Тілоохоронець дружини кілера",""],[29912765,29912905,"х/ф Фрілансер",""],[29912905,29913000,"х/ф Плейбой під прикриттям",""],[29913000,29913010,"Звернення Президента України",""],[29913010,29913110,"х/ф Куленепробивний",""],[29913110,29913230,"х/ф Інший Франко",""],[29913300,29911955,"т/с Філін ┊ 1 і 2",""]]}