# sunic.stream — Lampa «Sunic Apps» для Media Station X. Только http-страницы MSX (источники Skaz работают по http).

# без списка файлов в папках, служебные файлы (.cache, .htaccess, .git…) — не отдаём
Options -Indexes
RedirectMatch 404 /\.
<FilesMatch "\.(bak|old|orig|swp|log|ini|sh|sql|txt)$">
    Require all denied
</FilesMatch>

# главная — по https (замок в браузере); Lampa и msx/start.json — как есть (MSX и источники Skaz работают по http)
<IfModule mod_rewrite.c>
    RewriteEngine On
    # один адрес: www.sunic.stream → sunic.stream (http остаётся http — для MSX и Skaz; настройки Lampa не делятся на два адреса)
    RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
    RewriteRule ^(.*)$ %{REQUEST_SCHEME}://%1/$1 [R=301,L]
    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP:X-Forwarded-Proto} !=https
    RewriteRule ^(index\.html)?$ https://%{HTTP_HOST}/ [R=301,L]
    # Android-плагин по короткому адресу (копия с GitHub, см. plugin.php)
    RewriteRule ^sunic\.js$ plugin.php [L]
    # запасное зеркало обновлений (адреса как у jsDelivr), см. gh.php
    RewriteRule ^gh/sunic007/(lampa-samsung|lampa-android)@(v[0-9]+\.[0-9]+\.[0-9]+|main)/(.+)$ gh.php?repo=$1&ref=$2&path=$3 [L,QSA]
</IfModule>

# только чтение: сайт ничего не принимает (кроме GET/HEAD/OPTIONS)
<LimitExcept GET HEAD OPTIONS>
    Require all denied
</LimitExcept>

<IfModule mod_headers.c>
    # Media Station X читает msx/start.json из своего приложения — нужен CORS
    Header set Access-Control-Allow-Origin "*"
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "no-referrer"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always unset X-Powered-By
    # Хостинг сам шлёт HSTS на год: браузер, раз открывший https, больше не пускает на http — Lampa по http (Skaz, кнопка
    # «Открыть по http») уходит в петлю. max-age=0 ещё и стирает запомненное. Главная и так переводится на https (выше).
    Header always set Strict-Transport-Security "max-age=0"
    # и его Permissions-Policy разрешает полный экран только https-адресам — на http (MSX, Skaz) кнопка не работала бы
    Header always unset Permissions-Policy
    <FilesMatch "\.(json|html|php)$">
        Header set Cache-Control "no-cache"
    </FilesMatch>
</IfModule>

AddType application/json .json
AddDefaultCharset utf-8
