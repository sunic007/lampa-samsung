# sunic.stream — Lampa «Sunic Apps» для Media Station X. Только http-страницы MSX (источники Skaz работают по http).

# без списка файлов в папках, служебные файлы (.cache, .htaccess, .git…) — не отдаём
Options -Indexes
RedirectMatch 404 /\.
<FilesMatch "\.(bak|old|orig|swp|log|ini|sh|sql|txt)$">
    Require all denied
</FilesMatch>

# только чтение: сайт ничего не принимает (кроме GET/HEAD/OPTIONS)
<LimitExcept GET HEAD OPTIONS>
    Require all denied
</LimitExcept>

<IfModule mod_headers.c>
    # Media Station X читает msx/start.json из своего приложения — нужен CORS
    Header set Access-Control-Allow-Origin "*"
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "no-referrer"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always unset X-Powered-By
    <FilesMatch "\.(json|html|php)$">
        Header set Cache-Control "no-cache"
    </FilesMatch>
</IfModule>

AddType application/json .json
AddDefaultCharset utf-8
