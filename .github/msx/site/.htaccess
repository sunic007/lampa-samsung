# sunic.stream — Lampa «Sunic Apps» для Media Station X. Только http-страницы MSX (источники Skaz работают по http).

# без списка файлов в папках, служебные файлы (.cache, .htaccess, .git…) — не отдаём
Options -Indexes
# /.well-known/ — открыта: выпуск сертификата (ACME) и security.txt
RedirectMatch 404 /\.(?!well-known/)
<FilesMatch "^(?!security\.txt$).*\.(bak|old|orig|swp|log|ini|sh|sql|txt)$">
    Require all denied
</FilesMatch>

# главная — по https (замок в браузере); Lampa и msx/start.json — как есть (MSX и источники Skaz работают по http)
<IfModule mod_rewrite.c>
    RewriteEngine On
    # один адрес: www.sunic.stream → sunic.stream (http остаётся http — для MSX и Skaz; настройки Lampa не делятся на два адреса)
    RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
    RewriteRule ^(.*)$ %{REQUEST_SCHEME}://%1/$1 [R=301,L]
    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP:X-Forwarded-Proto} !=https
    RewriteRule ^(index\.html)?$ https://%{HTTP_HOST}/ [R=301,L]
    # Android-плагин по короткому адресу (копия с GitHub, см. plugin.php)
    RewriteRule ^sunic\.js$ plugin.php [L]
    # запасное зеркало обновлений (адреса как у jsDelivr), см. gh.php
    RewriteRule ^gh/sunic007/(lampa-samsung|lampa-android)@(v[0-9]+\.[0-9]+\.[0-9]+|main)/(.+)$ gh.php?repo=$1&ref=$2&path=$3 [L,QSA]
    # зеркало IPTV-плейлистов (iptv-org, Free-TV) с диск-кешем, см. iptv.php
    RewriteRule ^iptv/([a-z]+)\.m3u$ iptv.php?l=$1 [L]
    # то же без http-каналов — для страницы по https (браузер их не загрузит)
    RewriteRule ^iptv/s/([a-z]+)\.m3u$ iptv.php?l=$1&s=1 [L]
</IfModule>

# PHP2Shell (CVE-2026-109618/109619, 2026-10): PHP 7.4 у хостинга исправления не получит — выключаем то, через что
# идёт атака (загрузка файлов, прогресс загрузки сессии). PHP здесь — через mod_lsapi (.user.ini он не читает)
<IfModule lsapi_module>
    php_flag session.upload_progress.enabled off
    php_flag file_uploads off
    php_value post_max_size 64K
</IfModule>

# только чтение: сайт ничего не принимает (кроме GET/HEAD/OPTIONS)
<LimitExcept GET HEAD OPTIONS>
    Require all denied
</LimitExcept>

<IfModule mod_headers.c>
    # Media Station X читает msx/start.json из своего приложения — нужен CORS
    Header set Access-Control-Allow-Origin "*"
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "no-referrer"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always unset X-Powered-By
    # Хостинг сам шлёт HSTS на год: браузер, раз открывший https, больше не пускает на http — Lampa по http (Skaz, кнопка
    # «Открыть по http») уходит в петлю. max-age=0 ещё и стирает запомненное. Главная и так переводится на https (выше).
    Header always set Strict-Transport-Security "max-age=0"
    # и его Permissions-Policy разрешает полный экран только https-адресам — на http (MSX, Skaz) кнопка не работала бы
    Header always unset Permissions-Policy
    <FilesMatch "\.(json|html|php)$">
        Header set Cache-Control "no-cache"
    </FilesMatch>
    # зеркало IPTV-плейлистов (iptv.php) ставит кеш сам — no-cache выше его перебивает, возвращаем
    <If "%{REQUEST_URI} =~ m#^/iptv/#">
        Header set Cache-Control "public, max-age=3600"
    </If>
</IfModule>

# главная: строгая политика — только свои файлы и три адреса, откуда берётся версия (Lampa в /lampa/ — без неё)
<If "%{REQUEST_URI} =~ m#^/(index\.html)?$#">
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; media-src 'self'; connect-src 'self' https://raw.githubusercontent.com https://cdn.jsdelivr.net https://api.github.com; frame-ancestors 'none'; base-uri 'none'; form-action 'none'; object-src 'none'; upgrade-insecure-requests"
    Header always set Cross-Origin-Opener-Policy "same-origin"
</If>

# сроки кеша: картинки и видео меняются редко — месяц; site.css/site.js — год (адрес с меткой версии)
<IfModule mod_headers.c>
    <FilesMatch "\.(png|jpe?g|svg|ico|webp|mp4)$">
        Header set Cache-Control "public, max-age=2592000"
    </FilesMatch>
    <If "%{REQUEST_URI} =~ m#^/site\.(css|js)$#">
        # в главной они с меткой версии (?v=, stamp.py) — новая версия идёт по новому адресу, старую можно держать год
        Header set Cache-Control "public, max-age=31536000, immutable"
    </If>
</IfModule>

AddType application/json .json
AddType image/webp .webp
AddDefaultCharset utf-8
